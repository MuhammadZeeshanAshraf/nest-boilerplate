# Copy to .env when running e2e tests locally:
#   cp .env.test.example .env
#
# CI does this automatically and points DB_* at the Postgres service
# container defined in .github/workflows/ci.yml.

NODE_ENV=test
PORT=3000

LOG_LEVEL=warn
CORS_ORIGIN=http://localhost

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nest_boilerplate_test
DB_SCHEMA=public
DB_CONNECTION_NAME=default

THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# Email is opt-in. Leave the provider empty so the module stays
# disabled and provider-specific vars are not required.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_REPLY_TO=
