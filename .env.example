# Environment
NODE_ENV=development
PORT=3000

# Logging
# LOG_LEVEL controls Pino verbosity: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# CORS
# Use "*" for any origin, or a comma-separated list of allowed origins.
CORS_ORIGIN=*

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nest_boilerplate
DB_SCHEMA=public
DB_CONNECTION_NAME=default

# Rate Limit
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ============================================================
# Email
# ------------------------------------------------------------
# Set EMAIL_PROVIDER to one of: ses | mailgun | resend
# Leave EMAIL_PROVIDER empty to disable the email module.
# Only the section matching EMAIL_PROVIDER is required.
# ============================================================
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- AWS SES (only required when EMAIL_PROVIDER=ses) ---
AWS_SES_REGION=
# Leave the access keys empty to use the default AWS credential chain
# (env vars, shared config, IAM role on EC2/ECS/EKS).
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# --- Mailgun (only required when EMAIL_PROVIDER=mailgun) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us

# --- Resend (only required when EMAIL_PROVIDER=resend) ---
RESEND_API_KEY=
