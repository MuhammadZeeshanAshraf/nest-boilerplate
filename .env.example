# Environment
NODE_ENV=development
PORT=3000

# Logging
# LOG_LEVEL controls Pino verbosity: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# CORS
# Use "*" for any origin, or a comma-separated list of allowed origins.
CORS_ORIGIN=*

# Rate Limit
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Database (wired in a later release)
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SCHEMA=
DB_CONNECTION_NAME=
