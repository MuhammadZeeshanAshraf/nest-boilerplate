# Environment
NODE_ENV=development
PORT=3000

# Logging
# LOG_LEVEL controls Pino verbosity: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# CORS
# Use "*" for any origin, or a comma-separated list of allowed origins.
CORS_ORIGIN=*

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nest_boilerplate
DB_SCHEMA=public
DB_CONNECTION_NAME=default

# Rate Limit
THROTTLE_TTL=60
THROTTLE_LIMIT=10
